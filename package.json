{
  "name": "my_portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Portfolio von Erwin Holzhauser (Vite + Vue)",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b",
    "prettier:check": "prettier --check \"src/**/*.{ts,vue,scss,css}\"",
    "prettier:write": "prettier --write \"src/**/*.{ts,vue,scss,css}\"",
    "lighthouse": "npx lighthouse http://localhost:4173 --chrome-flags=\"--headless\" --output html --output-path ./lighthouse/report.html"
  },
  "dependencies": {
    "vue": "^3.5.45",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/tsconfig": "^0.9.1",
    "prettier": "^3.10.1",
    "sass-embedded": "^1.108.2",
    "typescript": "^6.0.3",
    "vite": "^7.3.8",
    "vue-tsc": "^3.3.14"
  }
}
